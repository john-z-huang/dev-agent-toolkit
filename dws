#!/bin/bash

# 从项目根目录定位实现，使入口不依赖调用者的工作目录。
script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || exit 1

refresh_management_tool() {
    local argument
    for argument in "$@"; do
        [[ "$argument" == -- ]] && break
        # argparse 也接受无歧义的长选项缩写。
        if [[ "$argument" == -h || ( "$argument" == --?* &&
              ( --help == "$argument"* || --dry-run == "$argument"* ) ) ]]; then
            return 0
        fi
    done
    # 版本号未变化时也重新构建本地包。
    uv tool install --managed-python --reinstall-package dev-workflow-standards-tools \
        "$script_dir/mcp-server" >&2
}

case "${1:-}" in
    --uv-build)
        shift
        exec uv build --managed-python "$script_dir/mcp-server" --out-dir "$script_dir/dist" "$@"
        ;;
    --uv-tool-install)
        shift
        if [[ $# -eq 0 || ( $# -eq 1 && $1 == --force ) ]]; then
            version="$(uv version --short --project "$script_dir/mcp-server")" || exit $?
            wheel="$script_dir/dist/dev_workflow_standards_tools-$version-py3-none-any.whl"
            if [[ ! -f "$wheel" ]]; then
                printf '找不到当前版本的 wheel，请先运行 ./dws --uv-build。\n  %s\n' "$wheel" >&2
                exit 1
            fi
            set -- "$@" "$wheel"
        fi
        exec uv tool install --managed-python "$@"
        ;;
    --hooks-install|--hooks-update)
        operation="$1"
        shift
        case "$operation" in
            --hooks-install) set -- --install "$@" ;;
            --hooks-update) set -- --update "$@" ;;
        esac
        exec uv run --managed-python -- "$script_dir/scripts/setup-codex-hooks.py" "$@"
        ;;
    --skills-install|--skills-update|--agents-install|--agents-update)
        operation="$1"
        shift
        # 管理资源必须使用完整发行包入口，不能从可编辑源码环境导入。
        refresh_management_tool "$@" || exit $?
        tool_bin="$(uv tool dir --bin)" || exit $?
        case "$operation" in
            --skills-install) set -- skills install "$@" ;;
            --skills-update) set -- skills update "$@" ;;
            --agents-install|--agents-update)
                # 项目入口默认读取当前模板，调用方可用后面的 --source 覆盖。
                set -- agents update --source "$script_dir/instructions/codex-global.md" "$@"
                ;;
        esac
        exec "$tool_bin/dev-workflow-standards" "$@"
        ;;
    --mcp-install)
        shift
        set -- --install "$@"
        ;;
    --mcp-update)
        shift
        set -- --install --force "$@"
        ;;
    --help|-h|"")
        cat <<'HELP'
用法：./dws 操作参数 [对应操作的选项]
  --uv-build        仅构建 mcp-server 发行包，输出到仓库的 dist/
  --uv-tool-install [--force]  安装 dist/ 中与项目版本匹配的 wheel
  --uv-tool-install [uv 选项] <wheel 路径>  安装指定 wheel
  --mcp-install     安装 MCP 服务，并在 Codex 中注册和配置
  --mcp-update      更新 MCP 服务，并在 Codex 中注册和配置
  --skills-install  安装技能（Skill）
  --skills-update   更新技能（Skill）
  --agents-install  从仓库模板创建全局 AGENTS.md；已有文件须显式接管
  --agents-update   从仓库模板更新全局 AGENTS.md，保留备份与冲突校验
  --hooks-install   安装原生 Codex Hooks（--global 或 --project-root）
  --hooks-update    更新受管 Hooks，拒绝覆盖本地修改
正式安装和更新先从当前源码重建并刷新相应的 uv tool。
Skill 和 AGENTS.md 与 MCP 共用发行包。每次只更新选定资源。
预览和帮助跳过构建与工具刷新。Skill 和 AGENTS.md 的预览使用已安装工具。
在操作参数后加 --help 查看对应选项。MCP、Skill、AGENTS.md 和 Hooks 操作支持 --dry-run。
兼容原 MCP 参数，例如 --install --force 或 --env-only。
HELP
        exit 0
        ;;
esac

# exec 保留退出状态与信号语义；参数逐项转发，避免空格或通配符被重新解释。
exec uv run --managed-python -- "$script_dir/scripts/setup-codex-mcp.py" "$@"
